.env
.venv
exports/

# Build/tool artifacts. The root gitignore only covered
# data-preprocess/__pycache__, so a stray root node_modules (vitest cache) and
# scripts/__pycache__ were committable.
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/

# Claude Code local settings (settings.local.json, launch.json, lockfiles).
#
# Two rules, and the split matters. A pattern containing a slash is anchored to
# this file's directory, so `/.claude/*` covers ONLY the repo root — nested
# `.claude/` directories need their own unanchored rule or they quietly become
# tracked.
**/.claude/

# At the root, exclude the CONTENTS rather than the directory: git cannot
# re-include anything beneath an excluded directory, so `/.claude/` outright
# would make the negation below a no-op.
/.claude/*

# Shared skills are checked in — they are repo documentation that CLAUDE.md
# references, so they must exist for anyone who clones this.
!/.claude/skills/
