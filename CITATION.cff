cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
authors:
  - family-names: Madore
    given-names: Frédérick
    orcid: https://orcid.org/0000-0003-0959-2092
title: "IWAC Sentiment Analysis Visualization"
abstract: "Interactive SvelteKit application for visualizing sentiment analysis results on the Islam West Africa Collection (IWAC) corpus of francophone West African press. Provides comparative analysis across three AI models (ChatGPT, Gemini, Mistral) on three dimensions — polarity, subjectivity, and centrality of Islam/Muslims — together with inter-model agreement statistics, blind third-party arbiter evaluations, multilingual support (French/English), and comprehensive filtering and export capabilities."
version: 4.0.0
date-released: 2026-07-25
url: "https://github.com/fmadore/IWAC-sentiment-analysis"
repository-code: "https://github.com/fmadore/IWAC-sentiment-analysis"
repository-artifact: "https://iwac.frederickmadore.com/sentiment-analysis/"
license: MIT
