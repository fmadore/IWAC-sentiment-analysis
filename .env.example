# Copy to `.env` at the repo root. Read by the arbiter scripts only.

# Claude Opus 5 — the v2 panel arbiter. Paid; `--dry-run` needs no key.
ANTHROPIC_API_KEY=

# Hugging Face token with read access to the private `-full` mirror.
# The arbiter needs it: the public projection masks article text per row.
HF_TOKEN=

# Gemini — the v1 arbiter only, which is a frozen archive. Rarely needed.
GOOGLE_API_KEY=
