// Type-checks the files svelte-check never sees: the e2e specs and the tool
// configs. `npm run check` runs it through `tsc -p tsconfig.node.json`.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"e2e/**/*.ts",
		"vitest.config.ts",
		"playwright.config.ts",
		"eslint.config.js",
		"vite.config.ts",
		"deploy.config.js"
	]
}
