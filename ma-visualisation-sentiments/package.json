{
	"name": "iwac-visualisation-sentiments",
	"version": "4.0.0",
	"description": "Interactive SvelteKit application for visualizing sentiment analysis results on the Islam West Africa Collection (IWAC) corpus. Features comparative analysis between ChatGPT and Gemini models, multilingual support (French/English), and comprehensive filtering and export capabilities.",
	"author": {
		"name": "Frédérick Madore",
		"url": "https://www.frederickmadore.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fmadore/IWAC-sentiment-analysis.git"
	},
	"homepage": "https://fmadore.github.io/IWAC-sentiment-analysis/",
	"engines": {
		"node": ">=24"
	},
	"bugs": {
		"url": "https://github.com/fmadore/IWAC-sentiment-analysis/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"deploy": "npm run build && npx gh-pages -d build -t",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^4.15.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.6.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.17.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.0",
		"postcss": "^8.5.12",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.4.1",
		"publint": "^0.3.16",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.0.10",
		"vite-plugin-compression": "^0.5.1",
		"vitest": "^4.1.5"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"sentiment-analysis",
		"visualization",
		"natural-language-processing",
		"comparative-analysis",
		"chatgpt",
		"gemini",
		"islam",
		"west-africa",
		"journalism",
		"corpus-analysis"
	],
	"overrides": {
		"cookie": "^0.7.0",
		"picomatch@<2.3.2": "^2.3.2",
		"@tailwindcss/vite": {
			"vite": "$vite"
		},
		"svelte-echarts": {
			"echarts": "$echarts"
		}
	},
	"dependencies": {
		"@lucide/svelte": "^1.11.0",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@sveltejs/kit": "^2.58.0",
		"echarts": "^6.0.0",
		"esm-env": "^1.2.2",
		"openseadragon": "^6.0.2",
		"svelte-echarts": "^1.0.0"
	}
}
