{
	"name": "iwac-visualisation-sentiments",
	"version": "4.0.0",
	"description": "Interactive SvelteKit application for visualizing sentiment analysis results on the Islam West Africa Collection (IWAC) corpus. Features comparative analysis between ChatGPT, Gemini, and Mistral models, multilingual support (French/English), and comprehensive filtering and export capabilities.",
	"author": {
		"name": "Frédérick Madore",
		"url": "https://www.frederickmadore.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fmadore/IWAC-sentiment-analysis.git"
	},
	"homepage": "https://iwac.frederickmadore.com/sentiment-analysis/",
	"engines": {
		"node": ">=24"
	},
	"bugs": {
		"url": "https://github.com/fmadore/IWAC-sentiment-analysis/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/nest-build.mjs && node scripts/stamp-sw.mjs",
		"preview": "vite preview",
		"deploy": "npm run build && npx gh-pages -d build -t",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && node scripts/check-store-cycles.mjs",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"type": "module",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.1",
		"@types/node": "^26.1.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.22.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"postcss": "^8.5.25",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vite-plugin-compression": "^0.5.1",
		"vitest": "^4.1.10"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"sentiment-analysis",
		"visualization",
		"natural-language-processing",
		"comparative-analysis",
		"chatgpt",
		"gemini",
		"islam",
		"west-africa",
		"journalism",
		"corpus-analysis"
	],
	"overrides": {
		"cookie": "^0.7.0",
		"picomatch@<2.3.2": "^2.3.2",
		"@tailwindcss/vite": {
			"vite": "$vite"
		},
		"svelte-echarts": {
			"echarts": "$echarts"
		}
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/kit": "^2.70.2",
		"echarts": "^6.1.0",
		"esm-env": "^1.2.2",
		"maplibre-gl": "^5.24.0",
		"openseadragon": "^6.0.2",
		"svelte-echarts": "^1.0.0",
		"svelte-maplibre-gl": "^2.2.0"
	}
}
