/* Import Tailwind CSS */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Import Skeleton theme */
/* Replace with your chosen theme, e.g., skeleton, modern, vintage, etc. */
/* You can find more themes here: https://www.skeleton.dev/docs/themes */
@import '@skeletonlabs/skeleton/themes/theme-skeleton.css';

/* Import Skeleton utilities */
@import '@skeletonlabs/skeleton/utilities/utilities.css';

/* Import Inter font from Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');

/* Your global custom CSS can go here */
/* For example:
body {
  font-family: 'Inter', sans-serif; 
}
*/
body {
  font-family: 'Inter', system-ui, sans-serif;
} 