@import 'tailwindcss';
@import '@skeletonlabs/skeleton';
@import '@skeletonlabs/skeleton/optional/presets';
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Skeleton Svelte Components - Adjust path if necessary based on your project structure */
/* @source '../node_modules/@skeletonlabs/skeleton-svelte/dist'; */ /* Let's hold off on @source for now if it's Svelte v5 */

/* Custom global styles for the 'mint' theme */
[data-theme='mint'] body {
  --body-background-color: #f8fafc;
  background-color: var(--body-background-color) !important;
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 1.08rem;
  line-height: 1.7;
  letter-spacing: 0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
  padding-bottom: 2rem;
}

/* Add some spacing for main container */
main.container {
  margin-top: 2.5rem;
  margin-bottom: 2.5rem;
}

/* Your global custom CSS can go here */
/* For example:
body {
  font-family: 'Inter', sans-serif; 
}
*/
:root {
  color-scheme: light !important;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: light !important;
  }
}
body {
  background-color: #fff !important;
  color-scheme: light !important;
  font-family: 'Inter', system-ui, sans-serif;
} 