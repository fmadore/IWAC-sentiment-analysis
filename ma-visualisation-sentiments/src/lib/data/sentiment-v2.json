{
	"schemaVersion": "2.1.0",
	"analysisVersion": "v2",
	"description": "Generation-2 five-model IWAC sentiment-analysis contract. Polarity and centrality scales are identical to v1; subjectivity is stored upstream as an ordinal label and is mapped to the shared 1-5 rank at generation time. Qwen's coverage is deliberately 153 articles short of the eligible corpus (a retired gap, not a failed run), so its scores carry legitimate nulls on every dimension.",
	"models": {
		"luna": {
			"displayName": "GPT-5.6 Luna",
			"analysisModel": "GPT-5.6 Luna",
			"hfPrefixes": ["gpt_5_6_luna"]
		},
		"mistral-small": {
			"displayName": "Mistral Small 4 (2603)",
			"analysisModel": "Mistral Small 4 2603",
			"hfPrefixes": ["mistral_small_2603"]
		},
		"deepseek": {
			"displayName": "DeepSeek v4 Flash",
			"analysisModel": "DeepSeek v4 Flash 0731",
			"hfPrefixes": ["deepseek_v4_flash_0731"]
		},
		"gemma": {
			"displayName": "Gemma 4 31B",
			"analysisModel": "Gemma 4 31B IT",
			"hfPrefixes": ["gemma_4_31b_it"]
		},
		"qwen": {
			"displayName": "Qwen3.8 27B",
			"analysisModel": "Qwen3.8 27B",
			"hfPrefixes": ["qwen3_8_27b"]
		}
	},
	"pairs": [
		{ "id": "luna-mistral-small", "models": ["luna", "mistral-small"] },
		{ "id": "luna-deepseek", "models": ["luna", "deepseek"] },
		{ "id": "luna-gemma", "models": ["luna", "gemma"] },
		{ "id": "luna-qwen", "models": ["luna", "qwen"] },
		{ "id": "mistral-small-deepseek", "models": ["mistral-small", "deepseek"] },
		{ "id": "mistral-small-gemma", "models": ["mistral-small", "gemma"] },
		{ "id": "mistral-small-qwen", "models": ["mistral-small", "qwen"] },
		{ "id": "deepseek-gemma", "models": ["deepseek", "gemma"] },
		{ "id": "deepseek-qwen", "models": ["deepseek", "qwen"] },
		{ "id": "gemma-qwen", "models": ["gemma", "qwen"] }
	],
	"fields": {
		"scores": ["centralite_islam_musulmans", "subjectivite_score", "polarite"],
		"justifications": [
			"centralite_justification",
			"subjectivite_justification",
			"polarite_justification"
		]
	},
	"scales": {
		"polarity": {
			"scores": {
				"Très positif": 5,
				"Positif": 4,
				"Neutre": 3,
				"Négatif": 2,
				"Très négatif": 1,
				"Non applicable": 0
			},
			"nonComparable": ["Non applicable"]
		},
		"centrality": {
			"scores": {
				"Très central": 5,
				"Central": 4,
				"Secondaire": 3,
				"Marginal": 2,
				"Non abordé": 1,
				"Non applicable": 0
			},
			"nonComparable": ["Non abordé", "Non applicable"]
		},
		"subjectivity": {
			"minimum": 1,
			"maximum": 5,
			"encoding": "label",
			"declined": "null",
			"scores": {
				"Très objectif": 1,
				"Plutôt objectif": 2,
				"Mixte": 3,
				"Plutôt subjectif": 4,
				"Très subjectif": 5
			}
		}
	},
	"discrepancy": {
		"significantDimensionGap": 3,
		"maximumTotal": 11,
		"missingSubjectivity": "skip-dimension",
		"nonComparableAnalysis": "exclude-row",
		"threeWaySpread": {
			"significantSpread": 3,
			"rule": "Per dimension, spread is max minus min across all models of the generation. A row is excluded when any model reports a non-comparable or missing polarity or centrality. Subjectivity contributes a spread only when every model scored it, otherwise 0."
		}
	},
	"arbiter": {
		"promptVersion": "v2.2.0",
		"arbiterModel": "claude-opus-5",
		"cacheSchemaVersion": 1,
		"mode": "panel",
		"eligibility": {
			"rule": "spread-or-valence-flip",
			"description": "What is worth paying to arbitrate, deliberately separate from `discrepancy.threeWaySpread`, which is what the dashboard flags to a reader. A spread of 3 on the 1-5 polarity scale already implies one model is positive and another negative, so the spread rule catches only the widest reversals; `valenceFlip` adds the rest, where one model answers Positif and another Négatif two ranks apart. Both rules read the same comparable rows: one non-comparable polarity or centrality still excludes the article.",
			"valenceFlip": {
				"dimension": "polarity",
				"positiveMinimum": 4,
				"negativeMaximum": 2
			}
		}
	},
	"delivery": {
		"justificationShards": 32
	},
	"provenance": {
		"sentimentPromptFingerprint": "d14ace9ac192",
		"sentimentPromptSource": "iwac-ai-pipelines/AI_sentiment_analysis/sentiment_prompt.md"
	}
}
